#. module: mail_drop_target
#: model_terms:ir.ui.view,arch_db:mail_drop_target.res_config_settings_view_form
msgid "Disable Mail Drag&Drop Notification"
msgstr "Вимкнути сповіщення Mail Drag&Drop"

#. module: mail_drop_target
#: model:ir.model.fields,field_description:mail_drop_target.field_res_config_settings__disable_notify_mail_drop_target
msgid "Disable Notification followers on mail dropped to a Thread"
msgstr "Вимкнути сповіщення підписників для листів, надісланих у тред"

#. module: mail_drop_target
#: model_terms:ir.ui.view,arch_db:mail_drop_target.res_config_settings_view_form
msgid ""
"When a user drops an email into an existing thread\n"
"                            the followers of the thread will not be notified."
msgstr ""
"Коли користувач додає лист у наявний ланцюжок,\n"
"                            підписники ланцюжка не отримають сповіщення."

#. module: mail_drop_target
#: model:ir.model.fields,help:mail_drop_target.field_res_config_settings__disable_notify_mail_drop_target
msgid ""
"When this setting is set, when a user drops an email into an existing thread"
" the followers of the thread will not be notified. This sets an "
"ir.config.parameter mail_drop_target.disable_notify"
msgstr ""
"Якщо цей параметр увімкнено, коли користувач перетягує електронний лист до "
"наявного ланцюжка, підписники цього ланцюжка не отримуватимуть сповіщень. "
"При цьому встановлюється параметр ir.config.parameter "
"mail_drop_target.disable_notify"

#. module: mail_drop_target
#. odoo-python
#: code:addons/mail_drop_target/models/mail_thread.py:0
msgid "Install the msg-extractor library to handle .msg files"
msgstr "Встановіть бібліотеку msg-extractor для обробки .msg-файлів"

#. module: mail_drop_target
#. odoo-python
#: code:addons/mail_drop_target/models/mail_thread.py:0
msgid "The already imported copy is attached to: %(locations)s"
msgstr "Раніше імпортовану копію прикріплено до: %(locations)s"

#. module: mail_drop_target
#. odoo-python
#: code:addons/mail_drop_target/controllers/discuss.py:0
msgid "You are not allowed to upload an attachment here."
msgstr "Вам не дозволено завантажувати вкладення сюди."

#. module: mail_drop_target
#. odoo-python
#: code:addons/mail_drop_target/models/mail_thread.py:0
msgid "a record that no longer exists."
msgstr "запис, якого більше не існує."

#. module: mail_drop_target
#. odoo-python
#: code:addons/mail_drop_target/models/mail_thread.py:0
msgid "a record you are not allowed to access."
msgstr "запис, до якого вам заборонено доступ."
